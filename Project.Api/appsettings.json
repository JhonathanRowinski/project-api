{
  "Authentication": {
    "Jwt": {
      "Issuer": "Project.Api",
      "Audience": "Project.Client",
      "AccessTokenLifetimeMinutes": 60,
      "RefreshTokenLifetimeDays": 3,
      "SessionLifetimeDays": 7
    }
  },
  "ClientIp": {
    "TrustedProxies": []
  },
  "IpGeolocation": {
    "GeoLite2DatabasePath": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
